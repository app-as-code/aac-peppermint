# Copy to .env and set every CHANGE_ME:  cp .env.example .env

# SECRET - set a strong value (must match the POSTGRES_* values)
DATABASE_URL=CHANGE_ME

# SECRET - set a strong value
DB_PASSWORD=CHANGE_ME

# SECRET - set a strong value
POSTGRES_PASSWORD=CHANGE_ME

# SECRET - set a strong value
SECRET=CHANGE_ME

# default: peppermint
POSTGRES_DB=peppermint

# default: peppermint
POSTGRES_USER=peppermint
